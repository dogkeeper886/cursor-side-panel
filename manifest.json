{
  "manifest_version": 3,
  "name": "Cursor Side Panel",
  "version": "0.2.0",
  "description": "Opens Cursor's agents web app in Chrome's side panel, beside any page.",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.cursor.com/*",
    "https://*.cursor.sh/*",
    "https://*.workos.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cursor.com/*"],
      "js": ["cursor-bridge.js"],
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Cursor"
  }
}
